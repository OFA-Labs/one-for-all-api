# fake is safe CI; select live for a consenting native session.
VOICE_PROVIDER_MODE=fake
# Exact app commands are the first iteration scope.
VOICE_COMMAND_ONLY=true
# Native pairing approval and a physical Caps press are required; env alone never arms capture.
VOICE_MIC_CONSENT=false
# false selects gated speaker mode; true is full-duplex headphone mode.
VOICE_HEADPHONES=false
# auto, en, hi or hinglish; the handoff overrides these language/device preferences.
VOICE_LANGUAGE=auto
# Provider credentials: set locally; no sample secret values are provided.
DEEPGRAM_API_KEY=${DEEPGRAM_API_KEY}
GRADIUM_API_KEY=${GRADIUM_API_KEY}
# No live LLM is connected in this iteration.
# Legacy observer token only; paired websites use key proof and never receive this token.
OFA_VOICE_TOKEN=${OFA_VOICE_TOKEN}
# Exact origins; leave undeployed environments empty. Never use wildcards.
OFA_DEV_ORIGIN=http://127.0.0.1:3000
OFA_STAGING_ORIGIN=
OFA_PRODUCTION_ORIGIN=
OFA_COMPANION_PORT=8767
# Optional Slack connector. Keep empty until an explicit live destination is ready.
# Bot requires files:write, files:read and membership in the selected channels.
OFA_SLACK_BOT_TOKEN=
OFA_SLACK_CHANNEL_IDS=
OFA_SLACK_TEAM_ID=
# Optional verified-tab control: install/pair the existing browse adapter first.
# An actual executable path and exact permitted destination origins are local settings.
OFA_BROWSE_BINARY=
OFA_BROWSER_ORIGINS=
