{
  "title": "ebrain-v3-schema-negotiation",
  "type": "object",
  "required": ["header", "requested_schema", "resolved_schema", "outcome", "reason"],
  "additionalProperties": false,
  "properties": {
    "header": {"enum": ["X-EBrain-Schema"]},
    "requested_schema": {"type": "integer", "minimum": 1},
    "resolved_schema": {"type": ["integer", "null"], "minimum": 1, "enum": [1, 3, null]},
    "outcome": {"enum": ["supported", "legacy", "rejected"]},
    "reason": {"type": "string", "minLength": 1}
  }
}
